<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="24dp">
<com.google.android.material.card.MaterialCardView android:id="@+id/remoteCard" style="@style/Widget.Material3.CardView.Filled" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
<TextView android:id="@+id/remoteStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="stopped" android:textAppearance="?attr/textAppearanceTitleMedium" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
  <com.google.android.material.button.MaterialButton android:id="@+id/rStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="▶ Start" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rStop" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="■ Stop" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="6dp">
  <com.google.android.material.button.MaterialButton android:id="@+id/rIsAd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="✓ Is an ad" app:backgroundTint="@color/adhush_teaching" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rShowBack" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:text="▶ Show\'s back" app:backgroundTint="@color/adhush_program" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rNotAd" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="✗ Not an ad" app:strokeColor="@color/adhush_ducked" android:textColor="@color/adhush_ducked" />
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="6dp" android:text="Duck for" android:textAppearance="?attr/textAppearanceLabelLarge" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck30" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="30 s" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck60" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="60 s" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck90" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="90 s" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck120" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="120 s" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck150" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="150 s" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp">
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck180" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="180 s" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck210" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="210 s" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck240" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="240 s" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck270" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="270 s" />
  <com.google.android.material.button.MaterialButton android:id="@+id/rDuck300" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="300 s" />
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/rDuckMore" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+30 s" />
</LinearLayout></com.google.android.material.card.MaterialCardView>
<TextView android:id="@+id/remoteNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="6dp" android:textAppearance="?attr/textAppearanceBodySmall" android:text="TV keys go through the network or the serial cable (RCKY codes). While AdHush runs they use its connection." />
<GridLayout android:id="@+id/keys" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="5" android:useDefaultMargins="true" />
</LinearLayout>
</androidx.core.widget.NestedScrollView>
